# =============================================================================
# OpenLife 环境变量配置示例
# =============================================================================
# 使用方法：
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 编辑 .env，填入你的实际配置值
#   3. 重新启动应用使配置生效
#
# 配置优先级：
#   环境变量 > config.yaml > 代码默认值
#
# ⚠️ 注意：.env 文件包含敏感信息，请勿提交到版本控制！
# =============================================================================

# ==========================================
# LLM API 配置（云端模型）
# ==========================================

# OpenRouter API Key（推荐，支持多种模型）
# 获取地址: https://openrouter.ai/keys
# 示例: OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# OpenAI API Key（如果使用 OpenAI 官方 API）
# 获取地址: https://platform.openai.com/api-keys
# 示例: OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# 自定义 API Base URL（可选）
# 默认值: https://api.openai.com/v1
# 如果使用 OpenRouter，可设置为: https://openrouter.ai/api/v1
# OPENAI_API_BASE=https://api.openai.com/v1

# ==========================================
# 本地模型配置（Ollama）
# ==========================================

# Ollama 默认运行在 http://localhost:11434
# 无需配置地址，只需确保 Ollama 服务已启动
# 启动命令: ollama serve
# 拉取模型: ollama pull qwen2.5:7b

# 启动时自动注册 filesystem MCP 服务（默认关闭）
# 试用阶段建议保持关闭；需要文件系统 MCP 时可在应用内手动注册，或显式开启。
# OPENLIFE_AUTOSTART_FILESYSTEM_MCP=1

# ==========================================
# 开发调试配置（可选）
# ==========================================

# 启用 Tauri 调试日志输出
# 设置任意非空值即可启用
# TAURI_DEBUG=1

# Vite 开发服务器端口（默认 5173）
# 如果 5173 被占用，可修改为其他端口
# PORT=5173
