{
  "name": "openlife-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9.1.0 <10"
  },
  "scripts": {
    "dev": "vite",
    "dev:phase4b": "vite --config vite.phase4b.config.ts",
    "dev:phase4c": "vite --config vite.phase4c.config.ts",
    "dev:phase4d": "vite --config vite.phase4d.config.ts",
    "build": "tsc && vite build && node scripts/verify-production-absence.mjs",
    "build:phase4b": "tsc && vite build --config vite.phase4b.config.ts",
    "build:phase4c": "tsc && vite build --config vite.phase4c.config.ts",
    "build:phase4d": "tsc && vite build --config vite.phase4d.config.ts",
    "preview": "vite preview",
    "qa:phase4b": "node scripts/phase4b-qa.mjs",
    "qa:phase4c": "node scripts/phase4c-qa.mjs",
    "qa:phase4d": "node scripts/phase4d-qa.mjs",
    "qa:phase4d:durable": "node scripts/phase4d-durable-qa.mjs",
    "qa:phase4d:settings": "node scripts/phase4d-settings-qa.mjs",
    "verify:release-absence": "node scripts/verify-production-absence.mjs",
    "test": "node scripts/run-current-vitest.mjs run && node scripts/test-current-test-selection.mjs && node scripts/check-current-test-selection.mjs",
    "test:watch": "node scripts/run-current-vitest.mjs --watch",
    "test:coverage": "node scripts/check-current-test-selection.mjs && node scripts/run-current-vitest.mjs run --coverage && node scripts/check-coverage-threshold.mjs",
    "test:coverage:checker": "node scripts/test-coverage-threshold.mjs",
    "test:selection:checker": "node scripts/test-current-test-selection.mjs && node scripts/check-current-test-selection.mjs",
    "test:historical": "vitest run --config scripts/vitest.historical.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test e2e/workbench-browser-shell.spec.ts",
    "test:e2e:ui": "playwright test e2e/workbench-browser-shell.spec.ts --ui"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.41",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.10",
    "terser": "^5.46.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
