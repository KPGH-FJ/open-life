# OpenLife 环境变量模板
# 复制本文件为 .env 并根据需要填写

# ==========================================
# LLM API 配置（云端模型）
# ==========================================

# OpenRouter API Key（推荐，支持多种模型）
# 获取地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 或 OpenAI API Key（如果使用 OpenAI 官方 API）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自定义 API Base URL（可选）
# 默认值: https://api.openai.com/v1
# OPENAI_API_BASE=https://openrouter.ai/api/v1

# ==========================================
# 本地模型配置（Ollama）
# ==========================================

# Ollama 默认已运行在 http://localhost:11434
# 无需配置，只需确保 Ollama 已启动
# 如需指定模型，请在应用设置页配置

# ==========================================
# A2A 服务配置（可选）
# ==========================================

# A2A 独立服务器监听端口
# 默认值: 8765
# A2A_PORT=8765

# 启动时自动注册 filesystem MCP 服务（默认关闭）
# 试用阶段建议保持关闭；需要文件系统 MCP 时可在应用内手动注册，或显式开启。
# OPENLIFE_AUTOSTART_FILESYSTEM_MCP=1

# ==========================================
# 开发调试配置（可选）
# ==========================================

# 启用 Tauri 调试日志
# TAURI_DEBUG=1

# Vite 开发服务器端口（默认 5173）
# PORT=5173
