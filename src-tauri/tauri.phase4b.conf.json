{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLife UI Foundation",
  "identifier": "ai.openlife.app.phase4b",
  "build": {
    "beforeDevCommand": "corepack pnpm --dir ../frontend dev:phase4b --host 127.0.0.1 --port 4184",
    "beforeBuildCommand": "node -e \"console.error('Phase 4B is development-only; release and package builds are forbidden.'); process.exit(1)\"",
    "devUrl": "http://127.0.0.1:4184/dev/phase4b/",
    "frontendDist": "../frontend/dist-phase4b"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenLife UI Foundation (Dev Only)",
        "url": "http://127.0.0.1:4184/dev/phase4b/",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
