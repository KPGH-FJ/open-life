{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLife Desktop Shell Review",
  "identifier": "ai.openlife.app.phase4c",
  "build": {
    "beforeDevCommand": {
      "script": "corepack pnpm dev:phase4c --host 127.0.0.1 --port 4185",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": "node -e \"console.error('Phase 4C is development-only; release and package builds are forbidden.'); process.exit(1)\"",
    "devUrl": "http://127.0.0.1:4185/dev/phase4c/",
    "frontendDist": "../frontend/dist-phase4c"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenLife Desktop Shell (Dev Only)",
        "url": "http://127.0.0.1:4185/dev/phase4c/",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
