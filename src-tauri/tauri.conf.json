{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLife",
  "version": "0.1.0",
  "identifier": "ai.openlife.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && corepack pnpm dev --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "cd ../frontend && corepack pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenLife",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data: https:; media-src 'self'; font-src 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
