{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLife",
  "version": "0.1.0",
  "identifier": "ai.openlife.app",
  "build": {
    "beforeBuildCommand": "cd ../frontend && npx tsc && npx vite build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenLife",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true,
        "focus": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
