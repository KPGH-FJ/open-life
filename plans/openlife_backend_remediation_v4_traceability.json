  "invariants": {
    "I01": "Ordinary Main Chat has one OpenLifeTurnRuntime.",
    "I02": "Policy decides allowed effects and never executes them.",
    "I03": "ProviderRouter selects only inside an allowed data route.",
    "I04": "Provider adapters never receive LifeModel or an unbounded store.",
    "I05": "Every product tool call enters ToolGateway.",
    "I06": "Every canonical write enters its domain gateway.",
    "I07": "No shared store or registry guard is held across an external await.",
    "I08": "Each fact has one canonical owner.",
    "I09": "Projection failure cannot create a second canonical truth.",
    "I10": "Proposal creation is not effect completion.",
    "I11": "Local abort is not remote cancellation.",
    "I12": "Unobserved state is unknown.",
    "I13": "Durable terminal facts are persisted before frontend delivery.",
    "I14": "Provider tokens may stream transiently but are not duplicated as a durable token transcript.",
    "I15": "Release durable stores never silently fall back to temporary or in-memory state.",
    "I16": "Release does not allow arbitrary local MCP command registration.",
    "I17": "Product UI formats backend facts and does not reinterpret them.",
    "I18": "Enabling a deep replacement module deletes the replaced product route."
  },
